{
  "rules": {
    ".read": false,
    ".write": false,
    "status": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        ".validate": "newData.hasChildren(['online', 'lastChanged'])",
        "online": {
          ".validate": "newData.isBoolean()"
        },
        "lastChanged": {
          ".validate": "newData.isNumber()"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "typingDm": {
      "$dmId": {
        ".read": "auth != null && ($dmId.beginsWith(auth.uid + '_') || $dmId.endsWith('_' + auth.uid))",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && ($dmId.beginsWith(auth.uid + '_') || $dmId.endsWith('_' + auth.uid))",
          ".validate": "newData.isNumber()"
        }
      }
    },
    "typingRoom": {
      "$roomId": {
        ".read": "auth != null && root.child('mirror/rooms').child($roomId).child(auth.uid).exists()",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && root.child('mirror/rooms').child($roomId).child(auth.uid).exists()",
          ".validate": "newData.isNumber()"
        }
      }
    },
    "voiceDm": {
      "$dmId": {
        ".read": "auth != null && ($dmId.beginsWith(auth.uid + '_') || $dmId.endsWith('_' + auth.uid))",
        "participants": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && ($dmId.beginsWith(auth.uid + '_') || $dmId.endsWith('_' + auth.uid)) && (!newData.exists() || (!root.child('mirror/dmBlocked').child($dmId).exists() && !root.child('mirror/bans').child(auth.uid).exists()))",
            ".validate": "newData.hasChildren(['joinedAt', 'session'])",
            "joinedAt": {
              ".validate": "newData.isNumber() && newData.val() <= now"
            },
            "session": {
              ".validate": "newData.isString() && newData.val().length < 40"
            },
            "muted": {
              ".validate": "newData.isBoolean()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "signals": {
          "$to": {
            ".read": "auth != null && auth.uid === $to",
            ".write": "auth != null && auth.uid === $to",
            "$from": {
              ".write": "auth != null && auth.uid === $from && ($dmId.beginsWith(auth.uid + '_') || $dmId.endsWith('_' + auth.uid))",
              "$sig": {
                ".validate": "newData.hasChildren(['type', 'ts']) && newData.child('ts').val() <= now",
                "type": {
                  ".validate": "newData.isString() && newData.val().matches(/^(offer|answer|ice|bye)$/)"
                },
                "sdp": {
                  ".validate": "newData.isString() && newData.val().length < 20000"
                },
                "candidate": {
                  ".validate": "newData.isString() && newData.val().length < 2000"
                },
                "session": {
                  ".validate": "newData.isString() && newData.val().length < 40"
                },
                "ts": {
                  ".validate": "newData.isNumber()"
                },
                "$other": {
                  ".validate": false
                }
              }
            }
          }
        }
      }
    },
    "voiceRoom": {
      "$roomId": {
        ".read": "auth != null && root.child('mirror/rooms').child($roomId).child(auth.uid).exists()",
        "participants": {
          "$uid": {
            ".write": "auth != null && ((auth.uid === $uid && (!newData.exists() || ((root.child('mirror/rooms').child($roomId).child(auth.uid).val() === 'member' || root.child('mirror/rooms').child($roomId).child(auth.uid).val() === 'owner') && !root.child('mirror/bans').child(auth.uid).exists()))) || (root.child('mirror/rooms').child($roomId).child(auth.uid).val() === 'owner' && !newData.exists()))",
            ".validate": "newData.hasChildren(['joinedAt', 'session'])",
            "joinedAt": {
              ".validate": "newData.isNumber() && newData.val() <= now"
            },
            "session": {
              ".validate": "newData.isString() && newData.val().length < 40"
            },
            "muted": {
              ".validate": "newData.isBoolean()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "signals": {
          "$to": {
            ".read": "auth != null && auth.uid === $to",
            ".write": "auth != null && auth.uid === $to",
            "$from": {
              ".write": "auth != null && auth.uid === $from && root.child('mirror/rooms').child($roomId).child(auth.uid).exists()",
              "$sig": {
                ".validate": "newData.hasChildren(['type', 'ts']) && newData.child('ts').val() <= now",
                "type": {
                  ".validate": "newData.isString() && newData.val().matches(/^(offer|answer|ice|bye)$/)"
                },
                "sdp": {
                  ".validate": "newData.isString() && newData.val().length < 20000"
                },
                "candidate": {
                  ".validate": "newData.isString() && newData.val().length < 2000"
                },
                "session": {
                  ".validate": "newData.isString() && newData.val().length < 40"
                },
                "ts": {
                  ".validate": "newData.isNumber()"
                },
                "$other": {
                  ".validate": false
                }
              }
            }
          }
        }
      }
    },
    "mirror": {
      ".read": false,
      ".write": false
    }
  }
}
