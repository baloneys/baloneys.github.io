rules_version = '2';

// ===============================================================
// Assumed Data Model  (/chat on kanaris-beans.com)
// ===============================================================
//
// Accounts are Firebase Auth email/password users. The email is a synthetic
// "<username>@chat.kanaris-beans.com" and is never stored in Firestore.
//
// usernames/{lowercaseName}         claim document, one per account
//   - uid: string (required, immutable) - owner's auth uid
//
// users/{uid}                       public profile (no PII)
//   - username: string (required, immutable, 3-20 [A-Za-z0-9_])
//   - color: string (required, #rrggbb)
//   - createdAt: timestamp (required, immutable, server time)
//   - bio: string (optional, <= 190)
//   - avatar: string (optional, data:image/... < 60000 chars)
//   - avatarScan: 'pending' | 'ok' (optional; only the server sets 'ok')
//
// blocks/{uid}/users/{otherUid}     { createdAt: timestamp }      owner only
// customs/{uid}/items/{id}          custom emoji / stickers
//   - kind: 'emoji' | 'sticker', name: string (2-32 [A-Za-z0-9_]),
//     data: data:image/... < 300000, scan: 'pending' (server sets 'ok'), createdAt: timestamp
// fcmTokens/{uid}/tokens/{token}    { createdAt: timestamp }      owner only
// readState/{uid}/convs/{convKey}   { at: timestamp }             owner only
//
// dms/{a_b}                         a < b are the two participant uids
//   - members: [a, b] (required, immutable, equals the id)
//   - updatedAt: timestamp (server time), last: { from: uid, text: <= 200 }
// dms/{a_b}/messages/{id}  and  rooms/{code}/messages/{id}
//   - from: uid (required, immutable), ts: timestamp (required, immutable)
//   - text (<= 2000) | image (data:image/... with scan 'pending', or https://*.giphy.com/...) | sticker (<= 80)
//   - scan: 'pending' | 'ok' | 'blocked' (only the server moves it past 'pending')
//   - held, edited, deleted: bool; replyTo: { id, from, text <= 200 }
//   - reactions: { <uid>: [emoji, ...up to 8] } - each user edits only their own entry
//   - kind: 'action' | 'system' (system only in rooms)
//
// rooms/{code}                      code = 6 chars [A-Z2-9]; get by code is the invite
//   - name (1-40), owner: uid (must be a member), createdAt, updatedAt: timestamp
//   - last: { from, text }, memberIds / muted / banned: uid lists (<= 200 / 200 / 500)
//
// mods/{uid}       exists => moderator. Written in the console only.
// bans/{uid}       { by: mod uid, ts, reason <= 200 }   (server writes by: 'auto')
// strikes/{uid}    { count }                             server only
// reports/{id}     { by, ts, type, reason, note?, target, path?, snapshot?, status,
//                    resolvedBy?, resolvedAt?, action?, evidence? (server), priority? (server) }
// flags/{id}       server-created image-filter results; mods update status
// modLog/{id}      { by, ts, action, uid?, room?, path?, reason? }  mods only
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function uidUnchanged() {
      return !('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid;
    }

    function uidNotModified() {
      return !('uid' in request.resource.data) || request.resource.data.uid == resource.data.uid;
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function isMod() {
      return isAuthenticated() && exists(/databases/$(database)/documents/mods/$(request.auth.uid));
    }

    function isBanned() {
      return exists(/databases/$(database)/documents/bans/$(request.auth.uid));
    }

    function hasBlocked(owner, other) {
      return exists(/databases/$(database)/documents/blocks/$(owner)/users/$(other));
    }

    function isStr(v, minLen, maxLen) {
      return v is string && v.size() >= minLen && v.size() <= maxLen;
    }

    function isValidOptionalString(data, field, minLen, maxLen) {
      return !(field in data) || isStr(data[field], minLen, maxLen);
    }

    function isValidOptionalBool(data, field) {
      return !(field in data) || data[field] is bool;
    }

    function isUid(v) {
      return isStr(v, 1, 128);
    }

    function isColor(v) {
      return v is string && v.matches('^#[0-9a-fA-F]{6}$');
    }

    function isImageData(v, maxLen) {
      return v is string && v.size() < maxLen && v.matches('^data:image/[a-z0-9.+-]+;base64,[A-Za-z0-9+/=]+$');
    }

    function isGiphyUrl(v) {
      return isStr(v, 20, 1000) && v.matches('^https://[a-z0-9]+[.]giphy[.]com/[A-Za-z0-9._/?=&%-]+$');
    }

    // Emoji reaction list: up to 8 short strings (checked element by element).
    function isEmoji(v) {
      return isStr(v, 1, 32);
    }

    function isEmojiList(l) {
      return l is list && l.size() >= 1 && l.size() <= 8
        && isEmoji(l[0])
        && (l.size() < 2 || isEmoji(l[1]))
        && (l.size() < 3 || isEmoji(l[2]))
        && (l.size() < 4 || isEmoji(l[3]))
        && (l.size() < 5 || isEmoji(l[4]))
        && (l.size() < 6 || isEmoji(l[5]))
        && (l.size() < 7 || isEmoji(l[6]))
        && (l.size() < 8 || isEmoji(l[7]));
    }

    function isValidLast(l) {
      return l is map && l.keys().hasOnly(['from', 'text']) && l.keys().hasAll(['from', 'text'])
        && l.from == request.auth.uid && isStr(l.text, 0, 200);
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================

    function isValidProfile(d) {
      return d.keys().hasOnly(['username', 'color', 'createdAt', 'bio', 'avatar', 'avatarScan'])
        && d.keys().hasAll(['username', 'color', 'createdAt'])
        && d.username is string && d.username.matches('^[A-Za-z0-9_]{3,20}$')
        && isColor(d.color)
        && d.createdAt is timestamp
        && isValidOptionalString(d, 'bio', 0, 190)
        && (!('avatar' in d) || isImageData(d.avatar, 60000))
        && (!('avatarScan' in d) || d.avatarScan in ['pending', 'ok']);
    }

    function isValidReplyTo(r) {
      return r is map && r.keys().hasOnly(['id', 'from', 'text']) && r.keys().hasAll(['id', 'from', 'text'])
        && isStr(r.id, 1, 40) && isUid(r.from) && isStr(r.text, 0, 200);
    }

    // Shape of any stored message (server-set fields included).
    function isValidMessage(d, allowSystem) {
      return d.keys().hasOnly(['from', 'ts', 'text', 'image', 'sticker', 'scan', 'held', 'edited', 'deleted', 'replyTo', 'reactions', 'kind'])
        && d.keys().hasAll(['from', 'ts'])
        && isUid(d.from) && d.ts is timestamp
        && isValidOptionalString(d, 'text', 1, 2000)
        && (!('image' in d) || isImageData(d.image, 950000) || isGiphyUrl(d.image))
        && isValidOptionalString(d, 'sticker', 1, 80)
        && (!('scan' in d) || d.scan in ['pending', 'ok', 'blocked'])
        && isValidOptionalBool(d, 'held') && isValidOptionalBool(d, 'edited') && isValidOptionalBool(d, 'deleted')
        && (!('replyTo' in d) || isValidReplyTo(d.replyTo))
        && (!('reactions' in d) || (d.reactions is map && d.reactions.size() <= 200))
        && (!('kind' in d) || d.kind == 'action' || (allowSystem && d.kind == 'system'))
        && ('text' in d || 'image' in d || 'sticker' in d || d.get('deleted', false) == true);
    }

    // A message as a client may first write it.
    function isValidNewMessage(d, allowSystem) {
      return isValidMessage(d, allowSystem)
        && d.from == request.auth.uid
        && d.ts == request.time
        && !d.keys().hasAny(['held', 'edited', 'deleted', 'reactions'])
        && (
          (!('image' in d) && !('scan' in d))
          || ('image' in d && isImageData(d.image, 950000) && d.get('scan', '') == 'pending')
          || ('image' in d && isGiphyUrl(d.image) && !('scan' in d))
        );
    }

    // Author edits the text of their own, still-visible message.
    function isAuthorEdit() {
      return resource.data.from == request.auth.uid
        && !resource.data.get('deleted', false) && !resource.data.get('held', false)
        && changedKeys().hasOnly(['text', 'edited'])
        && isStr(request.resource.data.text, 1, 2000)
        && request.resource.data.edited == true;
    }

    // Delete: content fields removed, deleted flag set. Used by authors, room hosts and mods.
    function isDeletion() {
      return changedKeys().hasOnly(['deleted', 'text', 'image', 'sticker', 'replyTo', 'reactions'])
        && request.resource.data.deleted == true
        && !request.resource.data.keys().hasAny(['text', 'image', 'sticker', 'replyTo', 'reactions']);
    }

    // A member toggles their own reactions and nothing else.
    function isOwnReactionChange() {
      let after = request.resource.data.get('reactions', {});
      let before = resource.data.get('reactions', {});
      return !resource.data.get('deleted', false)
        && changedKeys().hasOnly(['reactions'])
        && after is map && after.size() <= 200
        && after.diff(before).affectedKeys().hasOnly([request.auth.uid])
        && (!(request.auth.uid in after) || isEmojiList(after[request.auth.uid]));
    }

    function isValidRoom(d) {
      return d.keys().hasOnly(['name', 'owner', 'createdAt', 'updatedAt', 'last', 'memberIds', 'muted', 'banned'])
        && d.keys().hasAll(['name', 'owner', 'createdAt', 'updatedAt', 'memberIds', 'muted', 'banned'])
        && isStr(d.name, 1, 40)
        && isUid(d.owner)
        && d.createdAt is timestamp && d.updatedAt is timestamp
        && (!('last' in d) || (d.last is map && d.last.keys().hasOnly(['from', 'text']) && isUid(d.last.from) && isStr(d.last.text, 0, 200)))
        && d.memberIds is list && d.memberIds.size() >= 1 && d.memberIds.size() <= 200 && d.owner in d.memberIds
        && d.muted is list && d.muted.size() <= 200
        && d.banned is list && d.banned.size() <= 500;
    }

    function isValidCustom(d) {
      return d.keys().hasOnly(['kind', 'name', 'data', 'scan', 'createdAt'])
        && d.keys().hasAll(['kind', 'name', 'data', 'scan', 'createdAt'])
        && d.kind in ['emoji', 'sticker']
        && d.name is string && d.name.matches('^[A-Za-z0-9_]{2,32}$')
        && isImageData(d.data, 300000)
        && d.scan == 'pending'
        && d.createdAt == request.time;
    }

    function isValidNewReport(d) {
      return d.keys().hasOnly(['by', 'ts', 'type', 'reason', 'note', 'target', 'path', 'snapshot', 'status'])
        && d.keys().hasAll(['by', 'ts', 'type', 'reason', 'target', 'status'])
        && d.by == request.auth.uid
        && d.ts == request.time
        && d.type in ['message', 'user']
        && d.reason in ['child_safety', 'sexual', 'harassment', 'violence', 'self_harm', 'spam', 'other']
        && isValidOptionalString(d, 'note', 1, 500)
        && isUid(d.target)
        && (!('path' in d) || (d.path is string && d.path.matches('^(dms/[A-Za-z0-9]{1,128}_[A-Za-z0-9]{1,128}|rooms/[A-Z2-9]{6})/messages/[A-Za-z0-9]{1,40}$')))
        && (!('snapshot' in d) || (
          d.snapshot is map && d.snapshot.keys().hasOnly(['from', 'text', 'image', 'sticker'])
          && isUid(d.snapshot.from)
          && isValidOptionalString(d.snapshot, 'text', 1, 2000)
          && isValidOptionalString(d.snapshot, 'image', 1, 950000)
          && isValidOptionalString(d.snapshot, 'sticker', 1, 80)))
        && d.status == 'open';
    }

    // ===============================================================
    // Accounts
    // ===============================================================

    match /usernames/{name} {
      allow read: if isAuthenticated();
      // Only in the same batch that creates the caller's profile with this exact name,
      // so each account can hold exactly one username.
      allow create: if isAuthenticated()
        && name.matches('^[a-z0-9_]{3,20}$')
        && hasOnlyAllowedFields(['uid']) && hasRequiredFields(['uid'])
        && request.resource.data.uid == request.auth.uid
        && !exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username.lower() == name;
      allow update, delete: if false;
    }

    match /users/{uid} {
      // Public profile: username, colour, bio and avatar only. No email or other PII lives here.
      allow read: if isAuthenticated();
      allow create: if isOwner(uid)
        && isValidProfile(request.resource.data)
        && request.resource.data.createdAt == request.time
        && !request.resource.data.keys().hasAny(['avatar', 'avatarScan'])
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username.lower())).data.uid == uid;
      allow update: if (
          isOwner(uid)
          && isValidProfile(request.resource.data)
          && areImmutableFieldsUnchanged(['username', 'createdAt'])
          && (
            // New avatar: must start unscanned, and suspended users can't set one.
            (changedKeys().hasAny(['avatar']) && 'avatar' in request.resource.data
              && request.resource.data.avatarScan == 'pending' && !isBanned())
            // Avatar removed: its scan state goes with it.
            || (changedKeys().hasAny(['avatar']) && !('avatar' in request.resource.data)
              && !('avatarScan' in request.resource.data))
            // Anything else: avatar and scan state untouched.
            || !changedKeys().hasAny(['avatar', 'avatarScan'])
          )
        )
        || (
          // Moderators can only remove an avatar.
          isMod()
          && changedKeys().hasOnly(['avatar', 'avatarScan'])
          && !request.resource.data.keys().hasAny(['avatar', 'avatarScan'])
        );
      allow delete: if false;
    }

    match /blocks/{uid}/users/{other} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && other != uid
        && hasOnlyAllowedFields(['createdAt']) && request.resource.data.createdAt == request.time;
      allow update: if false;
      allow delete: if isOwner(uid);
    }

    match /customs/{uid}/items/{id} {
      allow read: if isAuthenticated();
      allow create: if isOwner(uid) && !isBanned() && isValidCustom(request.resource.data);
      allow update: if false;
      allow delete: if isOwner(uid) || isMod();
    }

    match /fcmTokens/{uid}/tokens/{token} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && token.size() <= 400
        && hasOnlyAllowedFields(['createdAt']) && request.resource.data.createdAt == request.time;
    }

    match /readState/{uid}/convs/{convKey} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && convKey.matches('^(dm_[A-Za-z0-9]{1,128}_[A-Za-z0-9]{1,128}|room_[A-Z2-9]{6})$')
        && hasOnlyAllowedFields(['at']) && request.resource.data.at == request.time;
    }

    // ===============================================================
    // Direct messages
    // ===============================================================

    match /dms/{dmId} {
      function dmIds() {
        return dmId.split('_');
      }
      function inDm() {
        return isAuthenticated() && dmIds().size() == 2 && request.auth.uid in dmIds();
      }
      function otherInDm() {
        return dmIds()[0] == request.auth.uid ? dmIds()[1] : dmIds()[0];
      }
      function canPost() {
        return inDm() && !isBanned() && !hasBlocked(otherInDm(), request.auth.uid);
      }
      function isValidDm(d) {
        return d.keys().hasOnly(['members', 'updatedAt', 'last'])
          && d.keys().hasAll(['members', 'updatedAt', 'last'])
          && d.members == dmIds()
          && d.updatedAt == request.time
          && isValidLast(d.last);
      }

      allow get: if inDm();
      allow list: if isAuthenticated() && request.auth.uid in resource.data.members;
      allow create: if canPost() && dmIds()[0] < dmIds()[1] && isValidDm(request.resource.data);
      allow update: if canPost() && isValidDm(request.resource.data) && changedKeys().hasOnly(['updatedAt', 'last']);
      allow delete: if false;

      match /messages/{msgId} {
        allow read: if inDm();
        allow create: if canPost() && isValidNewMessage(request.resource.data, false);
        allow update: if (inDm() && isValidMessage(request.resource.data, false) && areImmutableFieldsUnchanged(['from', 'ts', 'scan', 'held'])
            && (isAuthorEdit() || (resource.data.from == request.auth.uid && isDeletion()) || isOwnReactionChange()))
          || (isMod() && isValidMessage(request.resource.data, false) && isDeletion());
        allow delete: if false;
      }
    }

    // ===============================================================
    // Rooms
    // ===============================================================

    match /rooms/{code} {
      function me() {
        return request.auth.uid;
      }
      function before() {
        return resource.data;
      }
      function after() {
        return request.resource.data;
      }

      function isCreate() {
        return code.matches('^[A-Z2-9]{6}$')
          && isValidRoom(after())
          && after().owner == me()
          && after().memberIds == [me()] && after().muted == [] && after().banned == []
          && after().createdAt == request.time && after().updatedAt == request.time
          && !('last' in after())
          && !isBanned();
      }
      function isJoin() {
        return !(me() in before().memberIds) && !(me() in before().banned) && !isBanned()
          && changedKeys().hasOnly(['memberIds'])
          && after().memberIds.toSet() == before().memberIds.toSet().union([me()].toSet())
          && after().memberIds.size() == before().memberIds.size() + 1;
      }
      function isLeave() {
        return me() in before().memberIds && before().owner != me()
          && changedKeys().hasOnly(['memberIds'])
          && after().memberIds.toSet() == before().memberIds.toSet().difference([me()].toSet())
          && after().memberIds.size() == before().memberIds.size() - 1;
      }
      function isActivity() {
        return me() in before().memberIds && !(me() in before().muted) && !isBanned()
          && changedKeys().hasOnly(['updatedAt', 'last'])
          && after().updatedAt == request.time
          && isValidLast(after().last);
      }
      // Host tools: rename, transfer host (to a member), kick (remove), mute and ban members.
      function isHostChange() {
        return before().owner == me()
          && areImmutableFieldsUnchanged(['createdAt'])
          && changedKeys().hasOnly(['name', 'owner', 'memberIds', 'muted', 'banned', 'updatedAt', 'last'])
          && after().memberIds.toSet().difference(before().memberIds.toSet()).size() == 0
          && after().muted.toSet().difference(before().muted.toSet()).difference(before().memberIds.toSet()).size() == 0
          && after().banned.toSet().difference(before().banned.toSet()).difference(before().memberIds.toSet()).size() == 0
          && (!changedKeys().hasAny(['updatedAt']) || after().updatedAt == request.time)
          && (!changedKeys().hasAny(['last']) || isValidLast(after().last));
      }

      // Knowing the code is the invite, so any signed-in user can look a room up by code.
      allow get: if isAuthenticated();
      allow list: if isAuthenticated() && request.auth.uid in resource.data.memberIds;
      allow create: if isAuthenticated() && isCreate();
      allow update: if isAuthenticated() && isValidRoom(after()) && (isJoin() || isLeave() || isActivity() || isHostChange());
      allow delete: if isAuthenticated() && (resource.data.owner == request.auth.uid || isMod());

      match /messages/{msgId} {
        function room() {
          return get(/databases/$(database)/documents/rooms/$(code)).data;
        }
        function inRoom() {
          return isAuthenticated() && request.auth.uid in room().memberIds;
        }

        allow read: if inRoom();
        allow create: if inRoom() && !(request.auth.uid in room().muted) && !isBanned()
          && isValidNewMessage(request.resource.data, true);
        allow update: if (inRoom() && isValidMessage(request.resource.data, true) && areImmutableFieldsUnchanged(['from', 'ts', 'scan', 'held', 'kind'])
            && (isAuthorEdit() || ((resource.data.from == request.auth.uid || room().owner == request.auth.uid) && isDeletion()) || isOwnReactionChange()))
          || (isMod() && isValidMessage(request.resource.data, true) && isDeletion());
        allow delete: if false;
      }
    }

    // ===============================================================
    // Moderation
    // ===============================================================

    match /mods/{uid} {
      allow read: if isAuthenticated();
      allow write: if false; // managed in the Firebase console
    }

    match /bans/{uid} {
      allow read: if isAuthenticated();
      allow create, update: if isMod() && uid != request.auth.uid
        && hasOnlyAllowedFields(['by', 'ts', 'reason']) && hasRequiredFields(['by', 'ts', 'reason'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.ts == request.time
        && isStr(request.resource.data.reason, 1, 200);
      allow delete: if isMod();
    }

    match /strikes/{uid} {
      allow read: if isOwner(uid) || isMod();
      allow create, update: if false; // server only
      allow delete: if isMod();
    }

    match /reports/{id} {
      allow create: if isAuthenticated() && isValidNewReport(request.resource.data);
      allow read: if isMod();
      allow update: if isMod()
        && changedKeys().hasOnly(['status', 'resolvedBy', 'resolvedAt', 'action'])
        && request.resource.data.status in ['open', 'resolved', 'dismissed']
        && request.resource.data.resolvedBy == request.auth.uid
        && request.resource.data.resolvedAt == request.time
        && isStr(request.resource.data.action, 1, 200);
      allow delete: if false;
    }

    match /flags/{id} {
      allow read: if isMod();
      allow create, delete: if false; // server only
      allow update: if isMod() && changedKeys().hasOnly(['status']) && request.resource.data.status in ['open', 'resolved'];
    }

    match /modLog/{id} {
      allow read: if isMod();
      allow create: if isMod()
        && hasOnlyAllowedFields(['by', 'ts', 'action', 'uid', 'room', 'path', 'reason'])
        && hasRequiredFields(['by', 'ts', 'action'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.ts == request.time
        && isStr(request.resource.data.action, 1, 40)
        && isValidOptionalString(request.resource.data, 'uid', 1, 128)
        && isValidOptionalString(request.resource.data, 'room', 1, 10)
        && isValidOptionalString(request.resource.data, 'path', 1, 300)
        && isValidOptionalString(request.resource.data, 'reason', 1, 200);
      allow update, delete: if false;
    }
  }
}
